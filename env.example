# ElevenLabs
# Ключ берётся в настройках аккаунта. В репозиторий не коммитить.
ELEVENLABS_API_KEY=

# Voice IDs (Voice Design, приватные для аккаунта)
ELEVENLABS_VOICE_NARRATOR=tdl2YAu4Nj41holo8yUO
ELEVENLABS_VOICE_CHARACTER=EiVTLiipxYldU5SJvo5d

# Модель синтеза. Заполнить после того, как выберешь между
# eleven_v3 и eleven_multilingual_v2 на длинном тексте.
ELEVENLABS_TTS_MODEL=

# Формат выходного аудио, например mp3_44100_128
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Anthropic (Claude Code / API для пайплайна)
ANTHROPIC_API_KEY=

# ffmpeg. The Homebrew `ffmpeg` formula ships without libfreetype, so it has
# no drawtext/subtitles/ass filters. `ffmpeg-full` has them but is keg-only
# and must not be `brew link`ed — it would fight the plain formula. Point at
# it by absolute path instead, so a build does not depend on which shell
# started it.
#   brew install ffmpeg-full
FFMPEG_BIN=/usr/local/opt/ffmpeg-full/bin/ffmpeg

# Локальные пути
OUTPUT_DIR=./out
SCRIPTS_DIR=./scripts
