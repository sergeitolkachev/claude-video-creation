# Secrets
.env

# keys
.keys

# Editors
.idea
.DS_Store

# Python
.venv/
__pycache__/

# Generated media — reproducible from script.md, shots.yaml and the configs.
# Contents are ignored; the empty directories stay in the tree so the layout
# is visible without running anything.
episodes/*/anchors/*
episodes/*/cards/*
episodes/*/stills/*
episodes/*/approved/*
episodes/*/takes/*
episodes/*/audio/*
episodes/*/audio/*/*
episodes/*/out/*
!episodes/*/**/.gitkeep

# Channel art. Regenerated from config/brand.yaml.
brand/*
!brand/approved/
brand/approved/*
!brand/out/
brand/out/*
!brand/**/.gitkeep

# Channel statistics pulled by scripts/fetch_stats.py. Reproducible from the API.
analytics/

# Model bake-off takes. Findings live in research/*/README.md.
research/*/takes/
research/*/pending.json
research/*/compare-*.mp4
research/*/sheets/
